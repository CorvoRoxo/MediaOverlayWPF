<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Control" x:Key="MediaDetailControlVisibility">
        <Setter Property="Visibility" Value="Visible"/>
    </Style>

    <Style TargetType="StackPanel" x:Key="MediaDetailContainerVisibility">
        <Setter Property="Visibility" Value="Visible"/>
    </Style>

    <Style TargetType="Grid" x:Key="MainContainerVisualStyle">

    </Style>

    <Style TargetType="Image" x:Key="MediaThumbnailImageVisualStyle">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Width" Value="auto" />
    </Style>

    <Style TargetType="Button" x:Key="MenubuttonVisualStyle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        
        <Setter Property="Cursor" Value="Hand"/>
        
        <Setter Property="Padding" Value="6, 0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style TargetType="Button" x:Key="MediaControllerButton">
        <Setter Property="Padding" Value="12"/>
        
        <Setter Property="BorderBrush" Value="#D7462B5A"/>
        <Setter Property="Background" Value="#A2574B5F"/>
    </Style>
</ResourceDictionary>